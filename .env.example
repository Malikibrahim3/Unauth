# AfterShip tracking API (server-only, optional). Create an API key in
# AfterShip developer settings; used to enrich claim-gate tracking evidence.
AFTERSHIP_API_KEY=

# ShipBob fulfillment API (server-only, optional). Create a Personal Access
# Token in ShipBob; sandbox mode uses https://sandbox-api.shipbob.com/2026-01.
SHIPBOB_PAT=
SHIPBOB_SANDBOX=true
