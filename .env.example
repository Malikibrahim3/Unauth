# Direct carrier OAuth credentials (server-only, optional for local smoke tests).
# Merchant-specific credentials entered in Settings are encrypted in the database.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=

# ShipBob fulfillment API (server-only, optional). Create a Personal Access
# Token in ShipBob; sandbox mode uses https://sandbox-api.shipbob.com/2026-01.
SHIPBOB_PAT=
SHIPBOB_SANDBOX=true
