# Transactional email (optional, required for audit-complete and application emails)
RESEND_API_KEY=

# Amplitude — Get from Amplitude dashboard — create free account at amplitude.com
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# ---------------------------------------------------------------------------
# E2E integration suite (scripts/e2e) — see scripts/e2e/README.md
# Test-only. Read directly by the suite (not the Zod env schema).
# ---------------------------------------------------------------------------
# Shopify Admin REST (2024-01). Custom-app admin token + store host.
# Scopes needed: read/write_orders, read/write_customers, read/write_fulfillments.
SHOPIFY_ADMIN_API_TOKEN=             # shpat_… custom app admin API access token
SHOPIFY_STORE_DOMAIN=                # e.g. unauth-test.myshopify.com
# Gorgias REST API. Token is the API key; auth is Basic email:token.
GORGIAS_API_TOKEN=
GORGIAS_API_EMAIL=
GORGIAS_BASE_URL=                    # e.g. https://unauth.gorgias.com
# Deployed app the Gorgias webhook is registered against (must be public https;
# Gorgias rejects localhost). loadEnv overrides NEXT_PUBLIC_APP_URL with this.
E2E_WEBHOOK_URL=                     # e.g. https://your-app.vercel.app
# OPTIONAL: deliver the signed webhooks to a different host than registration —
# e.g. a local `next dev` running the latest code with this same .env.local.
# Use this when the deployed build lags (older code / different IDENTITY_SALT),
# so ingestion + the test compute identical email hashes. Leave unset to deliver
# to E2E_WEBHOOK_URL directly. Requires that host to be serving.
E2E_INGEST_URL=                      # e.g. http://localhost:3000
# Merchants. _B is auto-created by preflight if unset/invalid.
E2E_MERCHANT_ID=                     # UUID of the primary test merchant
E2E_MERCHANT_ID_B=                   # UUID; cross-merchant linking (auto-created if blank)
# SUPABASE_URL is bridged from NEXT_PUBLIC_SUPABASE_URL automatically if unset.
SUPABASE_URL=
# IMPORTANT: INTERNAL_HMAC_SECRET (and IDENTITY_SALT) here MUST match the DEPLOYED
# app, or signed webhooks fail with 401 (the secret hash won't verify).
