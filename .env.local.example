# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # optional alias for ANON key
SUPABASE_SERVICE_ROLE_KEY=         # server only, never client

# Identity hashing
IDENTITY_SALT=                      # 64+ random hex chars; rotate via migration

# Pepper for hashing API keys, widget tokens, and Gorgias webhook secrets (server-only)
INTERNAL_HMAC_SECRET=               # 32+ chars; REQUIRED in production/preview

# Internal support ticket ingest (server-only; x-unauth-internal-secret header)
INTERNAL_SUPPORT_INGEST_SECRET=     # 32+ chars; falls back to INTERNAL_HMAC_SECRET if unset

# Gorgias support ticket webhook (server-only)
GORGIAS_SUPPORT_WEBHOOK_SECRET=      # dev/test global fallback only; per-connection secrets preferred
GORGIAS_WEBHOOK_LOCAL_URL=http://localhost:3000  # used by post:gorgias-webhook-fixture when NEXT_PUBLIC_APP_URL is production

# Shopify integration (server-only). Create a custom app in the Shopify Partner
# dashboard; copy the API key/secret and webhook signing secret here.
# REQUIRED in production/preview. Scopes are defined in lib/shopify/scopes.ts.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# App
# Set this to the port your local `next dev` is actually using.
# If 3000 is busy, Next may fall back to 3001, 3002, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3000  # for local dev; use production URL only when testing deployed builds
AUDIT_EMAIL_FROM="Unauth <hello@unauth.app>"

# Transactional email (optional, required for case and operational notifications)
RESEND_API_KEY=

# Billing / Stripe (optional until self-serve checkout is enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_TOPUP=
BILLING_CONTACT_EMAIL=hello@unauth.co
BILLING_ACTIVE=

# Amplitude — Get from Amplitude dashboard — create free account at amplitude.com
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# Background jobs / cron (server-only). REQUIRED in production/preview.
CRON_SECRET=                          # bearer secret guarding scheduled-job routes

# Rate limiting (server-only). Upstash REQUIRED in production/preview;
# KV_* is an alternative backend used when Upstash is unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Evidence-pack PDF signing (server-only, optional). 32+ chars.
PDF_SIGNING_SECRET=

# Freshdesk support ticket webhook (server-only; parallels the Gorgias block above)
FRESHDESK_SUPPORT_WEBHOOK_SECRET=      # 32+ chars; dev/test global fallback only

# BigCommerce integration (server-only, optional)
BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_CLIENT_SECRET=

# Product gating (optional). When 'true', enforce paid-tier/product gates.
ENFORCE_PRODUCT_GATES=
NEXT_PUBLIC_ENFORCE_PRODUCT_GATES=

# Demo experience (optional). UUID of the public demo merchant;
# demo surfaces degrade to empty state when unset.
NEXT_PUBLIC_DEMO_MERCHANT_ID=

# Error monitoring (optional). Sentry DSN — read directly by lib/sentry.ts, not the Zod schema.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Operational tuning (optional; sensible defaults apply when unset).
# FLAG_THRESHOLD=44
# SUPABASE_DB_USAGE_LIMIT_MB=
# SUPABASE_DB_USAGE_HEADROOM_MB=

# ---------------------------------------------------------------------------
# E2E integration suite (scripts/e2e) — see scripts/e2e/README.md
# Test-only. Read directly by the suite (not the Zod env schema).
# ---------------------------------------------------------------------------
# Browser authentication helper. Local/test only; never configure in production.
E2E_AUTH_SECRET=
# Shopify Admin REST (2024-01). Custom-app admin token + store host.
# E2E ONLY — scripts/e2e/* and setup scripts. Merchant sync uses stored
# store_connections.credentials_encrypted, not this global token.
# Scopes needed: read/write_orders, read/write_customers, read/write_fulfillments.
SHOPIFY_ADMIN_API_TOKEN=             # shpat_… E2E custom app admin API access token (not merchant sync)
SHOPIFY_STORE_DOMAIN=                # e.g. unauth-test.myshopify.com
# Gorgias REST API. Token is the API key; auth is Basic email:token.
GORGIAS_API_TOKEN=
GORGIAS_API_EMAIL=
GORGIAS_BASE_URL=                    # e.g. https://unauth.gorgias.com
# Deployed app the Gorgias webhook is registered against (must be public https;
# Gorgias rejects localhost). loadEnv overrides NEXT_PUBLIC_APP_URL with this.
E2E_WEBHOOK_URL=                     # e.g. https://your-app.vercel.app
# OPTIONAL: deliver the signed webhooks to a different host than registration —
# e.g. a local `next dev` running the latest code with this same .env.local.
# Use this when the deployed build lags (older code / different IDENTITY_SALT),
# so ingestion + the test compute identical email hashes. Leave unset to deliver
# to E2E_WEBHOOK_URL directly. Requires that host to be serving.
E2E_INGEST_URL=                      # e.g. http://localhost:3000
# Merchants. _B is auto-created by preflight if unset/invalid.
E2E_MERCHANT_ID=                     # UUID of the primary test merchant
E2E_MERCHANT_ID_B=                   # UUID; cross-merchant linking (auto-created if blank)
E2E_CASE_ID=                         # UUID of the controlled payout case used by proof scripts
E2E_TICKET_ID=                       # Controlled provider ticket reference used by proof scripts
E2E_ORDER_NUMBER=                    # Controlled merchant order reference used by proof scripts
E2E_CUSTOMER_EMAIL=                  # Controlled customer email used by proof scripts
# SUPABASE_URL is bridged from NEXT_PUBLIC_SUPABASE_URL automatically if unset.
SUPABASE_URL=
# IMPORTANT: INTERNAL_HMAC_SECRET (and IDENTITY_SALT) here MUST match the DEPLOYED
# app, or signed webhooks fail with 401 (the secret hash won't verify).
