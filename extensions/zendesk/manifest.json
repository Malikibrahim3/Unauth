{
  "name": "Unauth Fraud Intelligence",
  "author": {
    "name": "Unauth",
    "email": "support@unauth.co",
    "url": "https://unauth.co"
  },
  "defaultLocale": "en",
  "private": true,
  "version": "1.0.1",
  "frameworkVersion": "2.0",
  "domainWhitelist": [
    "unauth-pi.vercel.app",
    "app.unauth.co",
    "unauth.co"
  ],
  "location": {
    "support": {
      "ticket_sidebar": {
        "url": "assets/iframe.html",
        "flexible": true
      }
    }
  },
  "parameters": [
    {
      "name": "app_base_url",
      "type": "url",
      "required": true,
      "default": "https://unauth-pi.vercel.app"
    },
    {
      "name": "api_key",
      "type": "text",
      "secure": true,
      "required": true,
      "scopes": ["header"]
    }
  ]
}
