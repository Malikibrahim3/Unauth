      "table": "support_payout_cases",
      "requiredBy": "RUN-01 \u2014 case decision endpoint",
      "columns": [
        "id",
        "merchant_id",
        "status",
        "responsibility_confirmation_state",
        "responsibility_confirmed_at",
        "responsibility_confirmed_by"
      ]
    },
    {
      "table": "case_claimed_items",
      "requiredBy": "RUN-03 \u2014 evidence reconciliation match endpoint",
