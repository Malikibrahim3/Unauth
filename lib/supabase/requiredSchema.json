        "id",
        "merchant_id",
        "support_payout_case_id",
        "source_order_line_id",
        "claimed_quantity",
        "match_status",
        "match_method",
        "match_confidence",
        "confirmed_by",
        "confirmed_at"
      ]
    },
    {
      "table": "case_clarification_requests",
      "requiredBy": "RUN-02 \u2014 investigation request/response history",
      "columns": [
        "id",
        "merchant_id",
        "support_payout_case_id",
        "partner_id",
        "status",
        "request_summary",
        "response_summary",
        "created_at"
      ]
    },
    {
      "table": "merchants",
