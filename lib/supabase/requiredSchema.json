      "columns": [
        "id",
        "investigation_response_sla_hours",
        "investigation_reply_to",
        "investigation_email_enabled"
      ]
    },
    {
      "table": "partners",
      "requiredBy": "RUN-02 \u2014 investigation partner resolution",
